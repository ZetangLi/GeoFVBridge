# Python bytecode and packaging metadata
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Test, lint, and coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build artifacts
build/
dist/
*.whl

# Local environments and editor settings
.venv/
venv/
.env
.env.*
.idea/
.vscode/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# GeoFVBridge runtime and generated solver artifacts
.runtime/
*.geofv.h5
*.summary.json
*.vtu
MESH
INCON
flow.inp
cell_map.csv
mesh_manifest.json
export_manifest.json
GeoFVBridge_Extract/
*.log

# Curated public example artifacts override the runtime-output rules above.
!examples/**/2_turn/*.geofv.h5
!examples/**/2_turn/*.summary.json
!examples/**/2_turn/*.vtu
!examples/**/2_turn/MESH
!examples/**/2_turn/cell_map.csv
!examples/**/2_turn/mesh_manifest.json
!examples/**/3_run/MESH
!examples/**/3_run/INCON
!examples/**/3_run/flow.inp
!examples/**/3_run/GeoFVBridge_Extract/
!examples/**/3_run/GeoFVBridge_Extract/**
